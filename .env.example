# Copie para .env e preencha os valores reais antes de subir com Docker

# Auth — Better Auth + Neon (banco dedicado do Workspace)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
BETTER_AUTH_SECRET=gerar-com-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3000

# Backends das ferramentas
NEXT_PUBLIC_PESQUISADOR_URL=http://localhost:8000
NEXT_PUBLIC_LUMEN_URL=http://localhost:8001

# Serviço aut-proposta (server-only — o proxy injeta o token; nunca NEXT_PUBLIC_)
PROPOSTA_URL="http://localhost:8000"
PROPOSTA_API_TOKEN="mesmo-API_TOKEN-do-servico"
